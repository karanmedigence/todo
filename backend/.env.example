MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=todo
REDIS_URL=redis://localhost:6379/0

# Retained as an access-token fallback for existing deployments.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
# Set distinct values for production; blank values use the legacy fallback.
ACCESS_TOKEN_SECRET_KEY=
REFRESH_TOKEN_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
